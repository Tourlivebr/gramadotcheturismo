---

<section class="relative pt-0 lg:pt-0 pb-12 lg:pb-20">
  <!-- Cabeçalho da seção -->
  <div class="text-center mb-6 relative z-20">
    <div class="flex items-center justify-center mb-6">
      <div class="h-px bg-gradient-to-r from-transparent via-primary-400 to-transparent flex-1 max-w-xs"></div>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mx-8">
        Ingressos e Atrações em <span class="text-primary-600 dark:text-primary-400">Gramado e Canela</span>
      </h2>
      <div class="h-px bg-gradient-to-r from-transparent via-primary-400 to-transparent flex-1 max-w-xs"></div>
    </div>
  </div>

  <ListaCards id="lista-ingressos" total={passeios.length}>
      {passeios.map((passeio, index) => (
          <div class="w-full" hidden={index >= 4} data-id={passeio.id}>
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group h-full flex flex-col">
              <div class="relative h-52 lg:h-56 overflow-hidden">
                <img 
                  src={passeio.imagem} 
                  alt={passeio.titulo}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute top-3 left-3">
                  <span class="bg-primary-600 text-white text-sm font-semibold px-3 py-1.5 rounded-full">
                    {passeio.categoria}
                  </span>
                </div>
                <div class="absolute top-3 right-3 bg-white/90 dark:bg-gray-900/80 backdrop-blur-sm rounded-full px-3 py-1.5 text-sm font-semibold text-gray-700 dark:text-gray-200 shadow">
                  ⭐ {passeio.avaliacao}
                </div>
              </div>
              <div class="p-4 lg:p-5 flex flex-col flex-1 gap-3">
                <h3 class="font-bold text-2xl lg:text-xl text-gray-900 dark:text-white leading-tight line-clamp-2">
                  {passeio.titulo}
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-lg lg:text-base leading-relaxed line-clamp-2 flex-1">
                  {passeio.subtitulo}
                </p>
                <div class="flex flex-wrap gap-2 mt-2 mb-2">
                  {passeio.tags.slice(0, 2).map(tag => (
                    <span class="px-3 py-1 bg-primary-50 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium line-clamp-1">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="flex flex-col gap-2 mt-auto">
                  <a
                    href={passeio.linkOficial}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-4 rounded-xl transition-colors duration-200 block text-center text-base shadow-md"
                  >
                    <span class="flex items-center justify-center">
                      RESERVE AGORA
                    </span>
                  </a>
                  <ContatosIngressos titulo={passeio.titulo} />
                </div>
              </div>
            </div>
          </div>
        ))}
  </ListaCards>
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-20">
    <svg 
      viewBox="0 0 1200 120" 
      preserveAspectRatio="none" 
      class="relative block w-[calc(100%+1.3px)] h-[40px] lg:h-[60px]"
    >
      <path d="M0,0 C300,120 900,120 1200,0 L1200,120 L0,120 Z" class="fill-gray-50 dark:fill-gray-900"></path>
    </svg>
  </div>
</section>
